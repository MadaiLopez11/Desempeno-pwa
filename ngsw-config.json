{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/icons/**",
          "/**.(svg|cur|jpg|jpeg|png|apng|webp|avif|otf|ttf|woff|woff2)"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "itunes-music-api",
      "urls": [
        "https://itunes.apple.com/search**"
      ],
      "cacheConfig": {
        "maxSize": 30,
        "maxAge": "2d",
        "timeout": "5s",
        "strategy": "freshness"
      }
    }
  ]
}